
{
  "entities": {
    "Student": {
      "title": "Élève",
      "description": "Profil complet de l'élève béninois",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "subdivision": { "type": "string" },
        "serie": { "type": "string", "enum": ["Général", "A", "C", "D", "G2", "G3"] },
        "status": { "type": "string", "enum": ["Actif", "En attente d'activation", "Transféré", "Exclu", "Diplômé", "Archivé"] },
        "isRepeater": { "type": "boolean" },
        "academicYear": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "validationCode": { "type": "string" }
      },
      "required": ["matricule", "classId", "academicYear"]
    },
    "Teacher": {
      "title": "Enseignant",
      "description": "Profil professionnel du professeur",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "subject": { "type": "string" },
        "phone": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Actif", "En attente", "Suspendu"] }
      }
    },
    "SchoolSettings": {
      "title": "Paramètres École",
      "description": "Identité visuelle et informations institutionnelles",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "motto": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "academicYear": { "type": "string" },
        "logoUrl": { "type": "string" },
        "signatureUrl": { "type": "string" },
        "stampUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "heroImageUrl": { "type": "string" }
      }
    },
    "TeacherAvailability": {
      "title": "Heure de cours",
      "description": "Planning hebdomadaire d'un enseignant",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "day": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "duration": { "type": "string" }
      }
    },
    "TeacherPresence": {
      "title": "Présence Enseignant",
      "description": "Suivi de ponctualité et pointage",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkInTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Présent", "Retard", "Absent", "Absence Autorisée"] }
      }
    },
    "Grade": {
      "title": "Note",
      "description": "Évaluation académique par matière",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "subjectLabel": { "type": "string" },
        "coefficient": { "type": "number" },
        "int1": { "type": "number" },
        "int2": { "type": "number" },
        "int3": { "type": "number" },
        "dev1": { "type": "number" },
        "dev2": { "type": "number" },
        "average": { "type": "number" },
        "term": { "type": "string", "enum": ["T1", "T2", "T3"] }
      }
    },
    "Conversation": {
      "title": "Discussion",
      "description": "Canal de communication entre utilisateurs",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Contenu d'une discussion",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Payment": {
      "title": "Paiement",
      "description": "Suivi des tranches de scolarité",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amountPaid": { "type": "number" },
        "tranche": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/school_settings/{schoolId}": { "schema": "SchoolSettings", "description": "Paramètres de l'école" },
    "/students/{studentId}": { "schema": "Student", "description": "Base élèves" },
    "/teachers/{teacherId}": { "schema": "Teacher", "description": "Base enseignants" },
    "/teacher_presence/{presenceId}": { "schema": "TeacherPresence", "description": "Émargement" },
    "/students/{studentId}/grades/{gradeId}": { "schema": "Grade", "description": "Notes" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Trésorerie" },
    "/conversations/{convId}": { "schema": "Conversation", "description": "Discussions" },
    "/conversations/{convId}/messages/{msgId}": { "schema": "Message", "description": "Messages" }
  }
}
