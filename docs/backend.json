
{
  "entities": {
    "Student": {
      "title": "Élève",
      "description": "Profil complet de l'élève béninois",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "subdivision": { "type": "string" },
        "serie": { "type": "string", "enum": ["Général", "A", "C", "D", "G2", "G3"] },
        "status": { "type": "string", "enum": ["Actif", "En attente d'activation", "Transféré", "Exclu", "Diplômé", "Archivé"] },
        "isRepeater": { "type": "boolean" },
        "academicYear": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "validationCode": { "type": "string" }
      },
      "required": ["matricule", "classId", "academicYear"]
    },
    "Grade": {
      "title": "Note",
      "description": "Évaluation académique par matière",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "subjectLabel": { "type": "string" },
        "coefficient": { "type": "number" },
        "quizScore": { "type": "number" },
        "examScore": { "type": "number" },
        "average": { "type": "number" },
        "rankInSubject": { "type": "number" },
        "teacherComment": { "type": "string" },
        "term": { "type": "string", "enum": ["T1", "T2", "T3"] }
      }
    },
    "Conversation": {
      "title": "Discussion",
      "description": "Canal de communication entre utilisateurs",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" },
        "type": { "type": "string", "enum": ["direct", "group"] }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Contenu d'une discussion",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Journal d'Audit",
      "description": "Trace de toutes les actions critiques",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "oldValue": { "type": "object" },
        "newValue": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Paiement",
      "description": "Suivi des tranches de scolarité",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "tranche": { "type": "string", "enum": ["Inscription", "Tranche 1", "Tranche 2", "Examen"] },
        "status": { "type": "string", "enum": ["Payé", "Partiel", "Impayé"] },
        "date": { "type": "string", "format": "date" },
        "receiptNo": { "type": "string" },
        "verificationCode": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/students/{studentId}": { "schema": "Student", "description": "Base élèves" },
    "/students/{studentId}/grades/{gradeId}": { "schema": "Grade", "description": "Notes de l'élève" },
    "/audit_logs/{logId}": { "schema": "AuditLog", "description": "Journal de sécurité" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Trésorerie" },
    "/conversations/{convId}": { "schema": "Conversation", "description": "Discussions actives" },
    "/conversations/{convId}/messages/{msgId}": { "schema": "Message", "description": "Messages d'une discussion" }
  }
}
