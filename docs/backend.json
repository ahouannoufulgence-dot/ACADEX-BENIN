
{
  "entities": {
    "Student": {
      "title": "Élève",
      "description": "Profil complet de l'élève béninois",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "subdivision": { "type": "string" },
        "serie": { "type": "string", "enum": ["Général", "A", "C", "D", "G2", "G3"] },
        "status": { "type": "string", "enum": ["Actif", "Transféré", "Exclu", "Diplômé", "Archivé"] },
        "isRepeater": { "type": "boolean" },
        "academicYear": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time", "description": "Date de suppression pour corbeille 30 jours" }
      },
      "required": ["fullName", "classId", "academicYear"]
    },
    "AuditLog": {
      "title": "Journal d'Audit",
      "description": "Trace de toutes les actions critiques",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "oldValue": { "type": "object" },
        "newValue": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" }
      }
    },
    "LoginHistory": {
      "title": "Historique Connexion",
      "description": "Suivi des accès au système",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "ip": { "type": "string" },
        "status": { "type": "string", "enum": ["Success", "Failed", "Blocked"] }
      }
    },
    "Payment": {
      "title": "Paiement",
      "description": "Suivi des tranches de scolarité",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "tranche": { "type": "string", "enum": ["Inscription", "Tranche 1", "Tranche 2", "Examen"] },
        "status": { "type": "string", "enum": ["Payé", "Partiel", "Impayé"] },
        "date": { "type": "string", "format": "date" },
        "receiptNo": { "type": "string" },
        "verificationCode": { "type": "string", "description": "Code unique pour QR verification" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/students/{studentId}": { "schema": "Student", "description": "Base élèves" },
    "/audit_logs/{logId}": { "schema": "AuditLog", "description": "Journal de sécurité" },
    "/login_history/{historyId}": { "schema": "LoginHistory", "description": "Accès système" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Trésorerie" }
  }
}
