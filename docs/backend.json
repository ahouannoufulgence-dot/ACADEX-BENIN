
{
  "entities": {
    "Student": {
      "title": "Élève",
      "description": "Profil complet de l'élève inscrit par lui-même",
      "type": "object",
      "properties": {
        "matricule": { "type": "string" },
        "lastName": { "type": "string" },
        "firstName": { "type": "string" },
        "gender": { "type": "string", "enum": ["Masculin", "Féminin"] },
        "phone": { "type": "string" },
        "cityOfBirth": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "parentName": { "type": "string" },
        "parentFirstName": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string", "enum": ["Actif", "En attente d'activation"] },
        "academicYear": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matricule", "lastName", "firstName", "classId"]
    },
    "RegistrationId": {
      "title": "Identifiant d'Inscription",
      "description": "Clé générée par le directeur pour permettre une inscription",
      "type": "object",
      "properties": {
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string", "enum": ["non utilisé", "utilisé"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Teacher": {
      "title": "Enseignant",
      "description": "Profil professionnel du professeur",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["En attente", "Actif", "Suspendu"] },
        "registeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "Grade": {
      "title": "Note",
      "description": "Évaluation académique par matière",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "term": { "type": "string" },
        "average": { "type": "number" },
        "coefficient": { "type": "number" }
      }
    },
    "Schedule": {
      "title": "Emploi du Temps",
      "description": "Session de cours programmée par un enseignant",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "subject": { "type": "string" },
        "day": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "room": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Paiement",
      "description": "Suivi des tranches de scolarité",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amountPaid": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" }
      }
    },
    "StudentLife": {
      "title": "Vie de l'Élève",
      "description": "Cahier de suivi : présence, discipline et conduite",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "category": { "type": "string", "enum": ["presence", "discipline", "observation", "conduite"] },
        "status": { "type": "string" },
        "pointsImpact": { "type": "number" },
        "motif": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SchoolSettings": {
      "title": "Paramètres École",
      "description": "Identité visuelle et institutionnelle",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "motto": { "type": "string" },
        "logoUrl": { "type": "string" },
        "academicYear": { "type": "string" },
        "conductRules": {
          "type": "object",
          "properties": {
            "tardy": { "type": "number", "default": -0.5 },
            "absence": { "type": "number", "default": -1 },
            "warning": { "type": "number", "default": -2 },
            "exclusion": { "type": "number", "default": -5 }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/school_settings/{schoolId}": { "schema": "SchoolSettings", "description": "Configuration école" },
    "/registration_ids/{regId}": { "schema": "RegistrationId", "description": "Identifiants à distribuer" },
    "/students/{studentId}": { "schema": "Student", "description": "Profils élèves inscrits" },
    "/teachers/{teacherId}": { "schema": "Teacher", "description": "Base enseignants" },
    "/grades/{gradeId}": { "schema": "Grade", "description": "Notes centralisées" },
    "/schedules/{scheduleId}": { "schema": "Schedule", "description": "Programmes des cours" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Trésorerie" },
    "/student_life/{eventId}": { "schema": "StudentLife", "description": "Registre de vie scolaire et conduite" }
  }
}
