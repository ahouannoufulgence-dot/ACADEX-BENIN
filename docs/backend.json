
{
  "entities": {
    "Student": {
      "title": "Élève",
      "description": "Profil complet de l'élève béninois",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string", "enum": ["Actif", "En attente d'activation", "Transféré", "Exclu"] },
        "academicYear": { "type": "string" },
        "validationCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matricule", "classId", "academicYear"]
    },
    "Teacher": {
      "title": "Enseignant",
      "description": "Profil professionnel du professeur",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "subject": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Actif", "Suspendu"] }
      }
    },
    "Grade": {
      "title": "Note",
      "description": "Évaluation académique par matière",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "term": { "type": "string" },
        "int1": { "type": "number" },
        "int2": { "type": "number" },
        "int3": { "type": "number" },
        "dev1": { "type": "number" },
        "dev2": { "type": "number" },
        "average": { "type": "number" },
        "coefficient": { "type": "number" }
      }
    },
    "Payment": {
      "title": "Paiement",
      "description": "Suivi des tranches de scolarité",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amountPaid": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "label": { "type": "string" }
      }
    },
    "SchoolSettings": {
      "title": "Paramètres École",
      "description": "Identité visuelle et institutionnelle",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "motto": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "academicYear": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/school_settings/{schoolId}": { "schema": "SchoolSettings", "description": "Configuration école" },
    "/students/{studentId}": { "schema": "Student", "description": "Base élèves" },
    "/teachers/{teacherId}": { "schema": "Teacher", "description": "Base enseignants" },
    "/grades/{gradeId}": { "schema": "Grade", "description": "Notes centralisées" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Trésorerie" },
    "/conversations/{convId}": { "schema": "Conversation", "description": "Discussions" }
  }
}
